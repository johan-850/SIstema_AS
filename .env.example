# ─────────────────────────────────────────────────────────────
# Abarrotería Pro — Variables de Entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Firebase (obtenida desde google-services.json / GoogleService-Info.plist)
# Configurar en android/app/google-services.json e ios/Runner/GoogleService-Info.plist

# App Config
APP_NAME=Abarrotería Pro
APP_ENV=development

# Feature Flags
ENABLE_OFFLINE_MODE=false
ENABLE_MULTI_STORE=false
